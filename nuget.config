<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Restrict restore to nuget.org: machine-level feeds that need credentials break
       a clean clone and, worse, a CI agent. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
