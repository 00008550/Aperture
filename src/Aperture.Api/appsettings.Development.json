{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Local development only. This key is public by definition — it is in the repository — which
  // is exactly why appsettings.json leaves the production one blank rather than defaulting to
  // something. Never promote this file.
  "Authentication": {
    "Issuer": "https://localhost/aperture",
    "Audience": "aperture-console",
    "SigningKey": "development-only-signing-key-do-not-use-anywhere-else"
  },
  // Local development only (010-P5a). A dedicated `aperture_dev` database on the compose Postgres, so the
  // compose default `aperture` database — which can hold a stale early schema — is never used, reset or
  // written by a dev run. `dotnet run --project src/Aperture.Api -- --seed-demo` creates and seeds it.
  "ConnectionStrings": {
    "Aperture": "Host=localhost;Port=5433;Database=aperture_dev;Username=aperture;Password=aperture",
    "ApertureReader": "Host=localhost;Port=5433;Database=aperture_dev;Username=aperture_reader"
  },
  "Aperture": {
    "ReaderPassword": "aperture_reader"
  }
}
