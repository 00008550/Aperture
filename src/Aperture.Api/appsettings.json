{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // ConnectionStrings:Aperture is the EF owner connection (owns the schemas, runs migrations,
  // bypasses RLS). ConnectionStrings:ApertureReader is the DISTINCT reader connection whose
  // username is the least-privilege `aperture_reader` role the RLS policies bind to. Neither
  // carries a password here: the owner credential comes from the deployment, and the reader
  // password comes from Aperture:ReaderPassword (a deploy secret), merged onto the reader string
  // at boot. The `aperture_reader` role is created password-less by the AddScopeReaderRole
  // migration precisely so the secret is provisioned out of band and never ships in the repo.
  "ConnectionStrings": {
    // "Aperture": "Host=…;Database=aperture;Username=aperture;Password=<from deployment>",
    // "ApertureReader": "Host=…;Database=aperture;Username=aperture_reader"
  }
  // No "Authentication" section here on purpose. Issuer, Audience and SigningKey come from the
  // deployment (environment or secret store) and the host refuses to start without them, so no
  // environment can inherit a signing key that shipped in the repository. The shape is
  // documented on ApertureJwtOptions; an empty section here would also silently override any
  // value a test or a deployment layered underneath it.
}
